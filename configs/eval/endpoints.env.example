# OpenAI-compatible harness engineer.
ENGINEER_BASE_URL=http://127.0.0.1:8142/v1
ENGINEER_MODEL=harness-engineer
ENGINEER_API_KEY_ENV=HARNESS_R1_ENGINEER_API_KEY
ENGINEER_CONCURRENCY=8
ENGINEER_MAX_TOKENS=12288
ENGINEER_TEMPERATURE=0.0
ENGINEER_TOP_P=1.0
ENGINEER_CHAT_TEMPLATE_KWARGS='{"enable_thinking":true}'

# Frozen target agent. This identity must match the endpoint used to generate
# the no-harness evidence JSONL.
TARGET_BASE_URL=http://127.0.0.1:8110/v1
TARGET_MODEL=Qwen3.5-9B
TARGET_AGENT_NAME=qwen35-9b-nothink
ROLLOUT_CONCURRENCY=16
ROLLOUT_MAX_TOKENS=4096
ROLLOUT_TOOL_CHOICE=auto
ROLLOUT_CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'

# Environment interpreters. Separate benchmark venvs are supported.
AGENTBENCH_PYTHON=
ALFWORLD_WORKER_PYTHON=
WEBSHOP_WORKER_PYTHON=
DBBENCH_WORKER_PYTHON=

# Optional network routing. Never put credentials in this file when it will be
# committed; keep API keys in the named environment variable.
HARNESS_R1_NO_PROXY=127.0.0.1,localhost,0.0.0.0
